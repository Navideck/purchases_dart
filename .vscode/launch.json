    "version": "0.2.0",
    "configurations": [
        {
            "name": "example",
            "cwd": "example",
            "request": "launch",
            "type": "dart"
        },
        {
            "name": "example (with webBillingApiKey)",
            "cwd": "example",
            "request": "launch",
            "type": "dart",
            "args": [
                "--dart-define=WEB_BILLING_API_KEY=${input:webBillingApiKey}"
            ]
        },
        {
            "name": "example (profile mode)",
            "cwd": "example",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile"
        },
        {
            "name": "example (release mode)",
            "cwd": "example",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release"
        }
    ],
    "inputs": [
        {
            "id": "webBillingApiKey",
            "type": "promptString",
            "description": "Enter RevenueCat Web Billing API Key",
            "default": ""
        }
    ]
}